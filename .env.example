# Copy to .env and fill in. `docker compose` reads this file automatically.

# Required: the GCP project that owns the Speech-to-Text API.
# If left blank, the backend falls back to the project_id inside gcp-key.json.
GCP_PROJECT_ID=your-gcp-project-id

# Recognizer location. Must be a region that actually offers the model:
# chirp_2 is NOT available in "global" (the API returns 'The model "chirp_2"
# does not exist in the location named "global"'). us-central1 is verified
# working. The backend automatically targets <location>-speech.googleapis.com
# whenever this is not "global".
GCP_LOCATION=us-central1

# Speech-to-Text v2 model.
STT_MODEL=chirp_2

# Comma-separated BCP-47 language codes.
STT_LANGUAGE_CODES=en-US

# --- Recording length -------------------------------------------------------
# Google's synchronous Recognize hard-caps at 60 seconds ("Audio can be of a
# maximum of 60 seconds."). Anything longer is split locally with ffmpeg at
# detected silences and stitched back together, so these limits are ours, not
# Google's — raise them freely.

# How long the browser may record in one take, in seconds (UI cap).
MAX_RECORDING_SECONDS=600

# Target length of each split piece, in seconds. Must stay under 60; the extra
# margin lets a cut drift to a nearby pause instead of landing mid-word.
CHUNK_SECONDS=50

# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=200
